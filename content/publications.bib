@inproceedings{roundtable2026,
  selected={false},
  title={Roundtable Policy: Scaling Multi-Agent Reasoning with Confidence-Weighted-Consensus},
  author={Yu Yao and Jiayi Dong and Zhenting Qi and Tianyu Wu and Chengxi Zhang and Himabindu Lakkaraju and Yang Yang and Yilun Du and Ju Li},
  year={2026},
  month=aug,
  booktitle={Workshop on Scientific Understanding of Foundation Models (Sci-FM)},
  venue={Sci-FM Workshop 2026},
  abstract={Multi-agent systems have demonstrated exceptional performance in downstream tasks beyond diverse single agent baselines. A growing body of work has explored ways to improve their reasoning and collaboration, from vote, debate, to complex interaction protocols. However, it still remains opaque why specific choice would be preferred in multi-agent systems. Inspired by the decision-making mechanism of democratic committees and The Society of Mind, we introduce Roundtable Policy, an inference-time reasoning framework for multi-agent systems that performs inference through the weighted consensus of multiple LLMs. Through extensive experiments, we demonstrate its that this approach significantly enhances reasoning in complex heterogeneous scientific tasks. Roundtable Policy emphasizes structured and interpretable inference rather than opaque convergence, while requires only black-box access and uniform procedures, making it broadly applicable to diverse multi-agent systems.},
  url={https://openreview.net/forum?id=gmMDBhTBEl},
  pdf={https://openreview.net/pdf?id=gmMDBhTBEl},
}

@inproceedings{morphbench2026,
  selected={false},
  title={Morph-Bench: Can Vision-Language Models Ground Images in Physical Scales?},
  author={Yu Yao and Yiqing Hang and Chengxi Zhang and Zhenting Qi and Jiayi Dong and Chia-Wei Hsu and Hanjun Luo and Ruixiang Liao and Himabindu Lakkaraju and Yilun Du and Ju Li},
  year={2026},
  month=sep,
  booktitle={2nd Workshop on Multimodal Reasoning and Slow Thinking in the Large Model Era (MARS2)},
  venue={MARS2 Workshop 2026},
  abstract={Scientific images are not merely pictures, their interpretation depends on connecting visual patterns to physical scale and experimental context. However, most multimodal benchmarks do not test whether vision-language models (VLMs) can make this connection. To tackle this challenge, we introduce Morph-Bench, a VLM benchmark for multi-scale-physics reasoning over scanning electron microscopy (SEM) images. Morph-Bench asks models to infer the physical field of view from texture and spatial statistics, and to distinguish composition-conditioned microstructures among scale-matched alternatives. We evaluate 15 open-weight VLMs and three closed frontier models across zero-shot, few-shot, and six test-time reasoning regimes. Through extensive experiments, we observe that (1) current VLMs recognize broad visual regimes, but remain unreliable when candidate answers differ only in subtle visual structure (2) few-shot examples improve coarse calibration more reliably than fine-grained perception, indicating that the main bottleneck is not task formatting but the extraction of physically meaningful spatial structure. We release the benchmark and evaluation pipeline to support the development of more credible scientific VLMs.},
  url={https://openreview.net/forum?id=N3GcmyaOoX},
  pdf={https://openreview.net/pdf?id=N3GcmyaOoX},
}

@inproceedings{folio2024,
  selected={false},
  title = {FOLIO: Natural Language Reasoning with First-Order Logic},
  author = {Simeng Han and Hailey Schoelkopf and Yilun Zhao and Zhenting Qi and Martin Riddell and Wenfei Zhou and James Coady and David Peng and Yujie Qiao and Luke Benson and Lucy Sun and Alex Wardle-Solano and Hannah Szabo and Ekaterina Zubova and Matthew Burtell and Jonathan Fan and Yixin Liu and Brian Wong and Malcolm Sailor and Ansong Ni and Linyong Nan and Jungo Kasai and Tao Yu and Rui Zhang and Alexander R. Fabbri and Wojciech Kryscinski and Semih Yavuz and Ye Liu and Xi Victoria Lin and Shafiq Joty and Yingbo Zhou and Caiming Xiong and Rex Ying and Arman Cohan and Dragomir Radev},
  year = {2024},
  month = dec,
  booktitle = {Conference on Empirical Methods in Natural Language Processing (EMNLP)},
  abstract = {FOLIO presents a dataset and benchmark for evaluating natural language reasoning capabilities of AI systems using First-Order Logic (FOL). The dataset comprises a wide range of reasoning tasks that require understanding and applying FOL principles to natural language statements. FOLIO serves as a valuable resource for developing and assessing models capable of logical reasoning in natural language contexts, advancing research in integrating formal logic with natural language understanding.},
  description = {We developed a comprehensive dataset and benchmark for natural language reasoning using First-Order Logic.},
  arxiv = {https://arxiv.org/abs/2209.00840}
}

@inproceedings{p-folio2024,
  selected={false},
  title = {P-FOLIO: Evaluating and Improving Logical Reasoning with Abundant Human-Written Reasoning Chains},
  author = {Simeng Han and Aaron Yu and Rui Shen and Zhenting Qi and Martin Riddell and Wenfei Zhou and Yujie Qiao and Yilun Zhao and Semih Yavuz and Ye Liu and Shafiq Joty and Yingbo Zhou and Caiming Xiong and Dragomir Radev and Rex Ying and Arman Cohan},
